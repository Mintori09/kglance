import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export component PreviewWindow inherits Window {
    in-out property<string> file-name;
    in-out property<string> status-text;
    in-out property<bool> is-visible;
    in-out property<image> preview-image;
    in-out property<string> text-content;
    in-out property<string> tree-content;
    in-out property<bool> show-text;
    in-out property<bool> show-image;
    in-out property<bool> show-tree;
    in-out property<bool> show-markdown;
    in-out property<styled-text> styled-content;

    title: file-name;
    min-width: 600px;
    min-height: 400px;

    VerticalBox {
        ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalBox {
                Text {
                    text: text-content;
                    visible: show-text;
                    wrap: word-wrap;
                    font-family: "monospace";
                    font-size: 13px;
                }
                Image {
                    source: preview-image;
                    visible: show-image;
                    image-fit: contain;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                }
                Text {
                    text: tree-content;
                    visible: show-tree;
                    wrap: no-wrap;
                    font-family: "monospace";
                    font-size: 13px;
                }
                StyledText {
                    text: styled-content;
                    visible: show-markdown;
                }
            }
        }

        HorizontalBox {
            padding-top: 4px;
            padding-bottom: 4px;
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: status-text;
                font-size: 12px;
                color: gray;
            }
        }
    }
}

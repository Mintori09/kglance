import { AppTheme } from "../theme.slint";

export component ToolbarButton inherits TouchArea {
    in property <string> icon-text;
    in property <color> icon-color: AppTheme.text;

    width: 28px;
    height: 28px;

    Rectangle {
        background: parent.has-hover ? AppTheme.row-hover : transparent;
        border-radius: 4px;
        width: 100%;
        height: 100%;

        Text {
            text: root.icon-text;
            font-size: 14px;
            color: root.icon-color;
            x: (parent.width - self.width)/2;
            y: (parent.height - self.height)/2;
        }
    }
}

export component NavButton inherits TouchArea {
    in property <string> icon-text;
    in property <bool> is-enabled;

    width: 32px;
    height: 32px;
    enabled: is-enabled;

    Rectangle {
        background: parent.has-hover && root.is-enabled ? AppTheme.row-hover : transparent;
        border-radius: 16px;
        width: 100%;
        height: 100%;
        opacity: root.is-enabled ? 1.0 : 0.3;

        Text {
            text: root.icon-text;
            font-size: 16px;
            color: AppTheme.text;
            x: (parent.width - self.width)/2;
            y: (parent.height - self.height)/2;
        }
    }
}

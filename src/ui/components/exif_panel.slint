import { VerticalBox } from "std-widgets.slint";
import { AppTheme } from "../theme.slint";

export component ExifPanel inherits Rectangle {
    in-out property<string> exif-text;

    background: AppTheme.status-bg;
    width: 220px;
    height: 100%;

    VerticalBox {
        padding: 8px;
        spacing: 4px;
        Text {
            text: "EXIF Info";
            font-weight: 700;
            font-size: 13px;
            color: AppTheme.text;
        }
        Text {
            text: exif-text;
            wrap: word-wrap;
            font-size: 11px;
            color: AppTheme.text-muted;
        }
    }
}
